async function showPage(
    page
) {

    document.querySelectorAll(
        ".page"
    ).forEach(
        (element) => {
            element.classList.add(
                "hidden"
            );
        }
    );


    document.querySelectorAll(
        ".nav-button"
    ).forEach(
        (element) => {
            element.classList.toggle(
                "active",
                element.dataset.page
                === page
            );
        }
    );


    document.getElementById(
        `${page}Page`
    ).classList.remove(
        "hidden"
    );


    if (page === "overview") {
        await loadOverview();
    }

    if (page === "leads") {
        await loadLeads();
    }

    if (page === "delivery") {
        await loadDelivery();
    }

    if (page === "analytics") {
        await loadAnalytics();
    }
}

async function loadLeadConversation(
    leadId
) {

    const container =
        document.getElementById(
            "conversationHistory"
        );

    const count =
        document.getElementById(
            "conversationCount"
        );


    if (
        !container ||
        !count
    ) {
        return;
    }


    container.innerHTML =
        '<p class="muted">Loading chat history...</p>';

    count.textContent = "";


    try {

        const data = await api(
            "/admin/leads/" +
            encodeURIComponent(
                leadId
            ) +
            "/conversation"
        );


        const messages =
            Array.isArray(
                data?.messages
            )
                ? data.messages
                : [];


        count.textContent =
            messages.length === 1
                ? "1 message"
                : (
                    messages.length
                    + " messages"
                );


        if (
            messages.length === 0
        ) {

            container.innerHTML =
                `
                <div class="chat-history-empty">
                    No stored chat history is available
                    for this lead.
                </div>
                `;

            return;
        }


        container.innerHTML =
            messages
                .map(
                    (message) => {

                        const role =
                            message.role ===
                            "user"
                                ? "user"
                                : "assistant";


                        const roleLabel =
                            role === "user"
                                ? "Customer"
                                : "AI Assistant";


                        return `
                            <div
                                class="chat-history-message ${role}"
                            >
                                <span
                                    class="chat-history-role"
                                >
                                    ${roleLabel}
                                </span>

                                <div
                                    class="chat-history-content"
                                >
                                    ${
                                        escapeHtml(
                                            message.content
                                            || ""
                                        )
                                    }
                                </div>
                            </div>
                        `;
                    }
                )
                .join("");


        container.scrollTop =
            container.scrollHeight;

    } catch (error) {

        console.error(
            "Could not load lead conversation:",
            error
        );


        count.textContent = "";


        container.innerHTML =
            `
            <div class="chat-history-empty">
                Chat history could not be loaded.
            </div>
            `;

    }
}


loginForm.addEventListener(
    "submit",
    async (
        event
    ) => {

        event.preventDefault();

        loginError.textContent =
            "";

        adminToken =
            tokenInput.value.trim();


        if (!adminToken) {
            return;
        }


        try {

            await loadOverview();

            loginScreen.classList.add(
                "hidden"
            );

            dashboard.classList.remove(
                "hidden"
            );

            tokenInput.value = "";

        } catch (
            error
        ) {

            adminToken = "";

            loginError.textContent =
                error.message;
        }
    }
);


document.getElementById(
    "logoutButton"
).addEventListener(
    "click",
    () => {

        adminToken = "";

        dashboard.classList.add(
            "hidden"
        );

        loginScreen.classList.remove(
            "hidden"
        );
    }
);


document.querySelectorAll(
    ".nav-button"
).forEach(
    (button) => {

        button.addEventListener(
            "click",
            async () => {

                try {
                    await showPage(
                        button.dataset.page
                    );

                } catch (
                    error
                ) {
                    alert(
                        error.message
                    );
                }
            }
        );

    }
);


document.getElementById(
    "applyFilters"
).addEventListener(
    "click",
    loadLeads
);


document.getElementById(
    "refreshLeads"
).addEventListener(
    "click",
    loadLeads
);


document.getElementById(
    "closeDialog"
).addEventListener(
    "click",
    () => {
        leadDialog.close();
    }
);