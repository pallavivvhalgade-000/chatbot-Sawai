# ==========================================
# Sawai Associates Chatbot
# Environment Configuration Template
# ==========================================

# LLM Provider
LLM_PROVIDER=groq

# Groq API
GROQ_API_KEY=your_groq_api_key_here

# Keep the model configurable.
LLM_MODEL=openai/gpt-oss-120b

# Application
APP_NAME=Sawai Associates AI Assistant
APP_ENV=development
DEBUG=true

# API
HOST=127.0.0.1
PORT=8000

# ==========================================
# Lead Notifications
# ==========================================

# Allowed initial values:
# none
# webhook
# smtp

NOTIFICATION_CHANNEL=none


# ------------------------------------------
# Webhook
# ------------------------------------------

NOTIFICATION_WEBHOOK_URL=


# ------------------------------------------
# SMTP Email
# ------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
LEAD_NOTIFICATION_TO_EMAIL=
SMTP_USE_TLS=true

# ==========================================
# API / Website
# ==========================================

CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://sawaiassociates.com,https://www.sawaiassociates.com

CHAT_RATE_LIMIT=20/minute

MAX_CHAT_MESSAGE_LENGTH=2000

# Optional customer-facing WhatsApp link.
# Leave blank until an approved business number/link is supplied.

RAG_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.45
RAG_MAX_CONTEXT_CHARS=12000

REQUIRE_CONTACT_CONSENT=true

ADMIN_API_ENABLED=false
ADMIN_API_TOKEN=

ALLOWED_HOSTS=127.0.0.1,localhost,sawaiassociates.com,www.sawaiassociates.com

WHATSAPP_URL=