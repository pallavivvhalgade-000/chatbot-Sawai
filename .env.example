# ==========================================
# Sawai Associates Chatbot
# Environment Configuration Template
# ==========================================

# LLM Provider
LLM_PROVIDER=groq

# Groq API
GROQ_API_KEY=your_groq_api_key_here

# Keep the model configurable.
LLM_MODEL=openai/gpt-oss-20b

# Application
APP_NAME=Sawai Associates AI Assistant
APP_ENV=development
DEBUG=true

# API
HOST=127.0.0.1
PORT=8000